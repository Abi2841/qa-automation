<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!-- Part D. When run on its own, the UI cross-check needs employer.admin.email / employer.admin.password. -->
<suite name="Part D - Employee REST Assured API Suite" verbose="1">

    <listeners>
        <listener class-name="com.uplift.reporting.ExtentTestListener"/>
    </listeners>

    <test name="REST Assured Authentication and Employee Endpoint Tests">
        <classes>
            <class name="com.uplift.tests.api.EmployeeApiTest"/>
        </classes>
    </test>

</suite>
