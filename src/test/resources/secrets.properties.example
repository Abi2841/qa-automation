# ==============================================================================
# SECRETS TEMPLATE - copy to secrets.properties (gitignored) and fill in locally.
# In Jenkins these are injected from the credentials store as environment variables
# (ADMIN_USERNAME, ADMIN_PASSWORD, ...), so this file is never needed on the CI agent.
# Never commit real values.
# ==============================================================================

# Admin portal test login (provided with the assignment)
admin.username=
admin.password=

# API credentials documented in the Swagger "authentication" section
api.auth.username=
api.auth.password=

# Test inbox you control (Gmail address + App Password). Invite emails go to <local>+qa-auto-...@<domain>
inbox.address=
inbox.username=
inbox.password=

# Optional: an already-activated QA-AUTO employer admin. Only needed when the API or
# validation suites run on their own (without the journey in the same run).
employer.admin.email=
employer.admin.password=
