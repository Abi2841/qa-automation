<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!-- Framework self-test: needs no browser, no network and no QA access. -->
<suite name="Framework Self-Test" verbose="1">

    <listeners>
        <listener class-name="com.uplift.reporting.ExtentTestListener"/>
    </listeners>

    <test name="Config, test data, CSV and report checks">
        <classes>
            <class name="com.uplift.tests.FrameworkSmokeTest"/>
        </classes>
    </test>

</suite>
