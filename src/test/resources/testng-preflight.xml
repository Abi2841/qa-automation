<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!-- Run first on call day: checks every URL / endpoint / credential you were given before the long journey. -->
<suite name="Preflight - QA Environment Readiness" verbose="1">

    <listeners>
        <listener class-name="com.uplift.reporting.ExtentTestListener"/>
    </listeners>

    <test name="Environment readiness" preserve-order="true">
        <classes>
            <class name="com.uplift.tests.PreflightTest"/>
        </classes>
    </test>

</suite>
